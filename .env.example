# Incident Shield - sandbox spike settings. Copy to .env and fill in. Never commit .env.

# Must be the PayPal SANDBOX host. Anything else stops the program at startup.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# REST app linked to your sandbox MERCHANT business account (Apps & Credentials > Sandbox)
MERCHANT_CLIENT_ID=
MERCHANT_CLIENT_SECRET=

# Optional: REST app linked to a SECOND sandbox business account that plays the
# "unknown sender". Used for inbound payouts carrying an attacker-controlled note.
SENDER_CLIENT_ID=
SENDER_CLIENT_SECRET=

# Optional override. Normally webhook-register writes spike_logs/webhook_id.txt.
PAYPAL_WEBHOOK_ID=

# From the sandbox credit card generator (developer dashboard > Testing tools)
SANDBOX_CARD_NUMBER=
# Expiry format: YYYY-MM
SANDBOX_CARD_EXPIRY=
SANDBOX_CARD_CVV=

# Neon Postgres connection string, only for the db-coldstart measurement
DATABASE_URL=

# Set to 1 to answer every webhook with 503 and watch PayPal's retry schedule
SPIKE_FORCE_503=0
