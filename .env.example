# Incident Shield - sandbox spike settings. Copy to .env and fill in. Never commit .env.

# Must be the PayPal SANDBOX host. Anything else stops the program at startup.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# REST app linked to your sandbox MERCHANT business account (Apps & Credentials > Sandbox)
MERCHANT_CLIENT_ID=
MERCHANT_CLIENT_SECRET=

# Optional: REST app linked to a SECOND sandbox business account that plays the
# "unknown sender". Used for inbound payouts carrying an attacker-controlled note.
SENDER_CLIENT_ID=
SENDER_CLIENT_SECRET=

# Optional: a SECOND app on the merchant account, used only for Transaction Search.
# Create it with "Transaction search" ticked BEFORE its first use.
REPORTING_CLIENT_ID=
REPORTING_CLIENT_SECRET=

# Optional override. Normally webhook-register writes spike_logs/webhook_id.txt.
PAYPAL_WEBHOOK_ID=

# From the sandbox credit card generator (developer dashboard > Testing tools)
SANDBOX_CARD_NUMBER=
# Expiry format: YYYY-MM
SANDBOX_CARD_EXPIRY=
SANDBOX_CARD_CVV=

# Neon Postgres connection string, only for the db-coldstart measurement
DATABASE_URL=

# Set to 1 to answer every webhook with 503 and watch PayPal's retry schedule
SPIKE_FORCE_503=0

# ---------------------------------------------------------------- application (app/)
# Uses MERCHANT_CLIENT_ID / MERCHANT_CLIENT_SECRET above.
# Webhook ID of the webhook pointing at THIS app's /webhooks/paypal URL.
# (python -m spike.run_spike webhook-register ... prints it.)
# Wait ~5 minutes after registering before sending payments: a new webhook missed events in the spike.
# PAYPAL_WEBHOOK_ID is shared with the spike section above.

# REQUIRED. Your sandbox merchant's PayPal merchant ID (in webhooks as resource.payee.merchant_id).
# Verified events naming a different merchant are quarantined, not processed. Spike value: HUU66NVJRLZ2L
PAYPAL_MERCHANT_ID=
# Global cap on webhook requests per minute (429 above it; PayPal retries) and parallel verify calls.
WEBHOOK_RATE_PER_MINUTE=300
VERIFY_CONCURRENCY=4

# Run: python scripts/make_owner_key.py   (the app stores only the hash)
OWNER_API_KEY_SHA256=

# Seconds between background sweeps that process any pending webhook events
PROCESS_INTERVAL_S=30

# Copilot (AI). Leave GEMINI_API_KEY empty to run with template answers only.
GEMINI_API_KEY=
# Check what your key can use: python scripts/list_gemini_models.py
GEMINI_MODEL=gemini-3.5-flash
# 3.5 Flash answered reliably in the first real test (2026-11-09) while 3.7/3.8 were overloaded.
# Tried once if the main model is overloaded (429/5xx) or slower than 20 s. Empty = no fallback.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Max real AI calls per day per scope (owner, judge). Cached answers don't count.
COPILOT_DAILY_BUDGET=40

# Tests only: a SEPARATE database whose name contains "test". Tests wipe it.
TEST_DATABASE_URL=
